# PS-2 backend configuration. Copy to `.env` (project root) and uncomment what you need.
# Real environment variables always take precedence over this file. No secrets are needed.

# --- API server ---------------------------------------------------------------
# PS2_HOST=127.0.0.1
# PS2_PORT=8000
# PS2_LOG_LEVEL=INFO

# --- Models (defaults: files under source/models/) -----------------------------
# PS2_DETECTOR_WEIGHTS=/path/to/yolo11n.pt
# PS2_DETECTOR_IMGSZ=640
# PS2_REID_CHECKPOINT=/path/to/best.pth
# PS2_REID_INPUT_H=256
# PS2_REID_INPUT_W=128
# PS2_TENSORRT_DIR=/path/to/tensorrt/engines

# --- Inference backend / device ------------------------------------------------
# auto | tensorrt | onnx-cuda | onnx-dml | pytorch-cuda | onnx-cpu | pytorch-cpu
# PS2_REID_BACKEND=auto
# auto | cpu | cuda | cuda:0   (torch device for the detector / PyTorch ReID)
# PS2_DEVICE=auto
# PS2_REID_BATCH=32
# fp32 | fp16
# PS2_TENSORRT_PRECISION=fp32
# PS2_TENSORRT_AUTO_BUILD=true
# PS2_REID_VERIFY_MIN_COSINE=0.9995
# Folder holding TensorRT + cuda-python installed with `pip --target` (default: <project>/.gpu_runtime)
# PS2_GPU_RUNTIME=/path/to/.gpu_runtime

# --- Jobs / uploads / output video ---------------------------------------------
# PS2_MAX_UPLOAD_MB=500
# PS2_MAX_CONCURRENT_JOBS=1
# PS2_MAX_QUEUED_JOBS=8
# PS2_JOB_TTL_HOURS=24
# PS2_KEEP_INPUTS=false
# PS2_TEMP_DIR=/path/to/upload/spool
# PS2_VIDEO_CODECS=H264@MSMF:.mp4,mp4v:.mp4,MJPG:.avi
